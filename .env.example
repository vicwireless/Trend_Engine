# Variable NAMES only. Never put real values in this file or in the repo.
# Local runs: copy to .env (gitignored). CI/executor: GitHub Actions secrets only.
ETSY_KEYSTRING=
ETSY_SHARED_SECRET=
# Read-scope refresh token from tools/etsy_oauth.py --mode read (valid 90 days)
ETSY_REFRESH_TOKEN=
# Optional 1-hour access token; normally refreshed from ETSY_REFRESH_TOKEN
ETSY_READ_TOKEN=
PRINTIFY_READ_TOKEN=
EVERBEE_CLIENT_ID=
EVERBEE_CLIENT_SECRET=
SERPAPI_KEY=
IMAGE_API_KEY=
PINTEREST_TOKEN=
PAYHIP_API_KEY=
