{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cohort",
  "type": "object",
  "properties": {
    "cohort_id": {
      "type": "string",
      "pattern": "^coh-[0-9]{4}-W[0-9]{2}-[a-z0-9-]+$"
    },
    "niche": {
      "type": "string",
      "minLength": 1
    },
    "launch_week": {
      "type": "string",
      "pattern": "^[0-9]{4}-W[0-9]{2}$"
    },
    "listing_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "integer",
            "minimum": 0
          },
          "as_of": {
            "type": "string",
            "format": "date"
          },
          "views": {
            "type": [
              "integer",
              "null"
            ]
          },
          "favorites": {
            "type": "integer",
            "minimum": 0
          },
          "orders": {
            "type": "integer",
            "minimum": 0
          },
          "revenue_usd": {
            "type": "number",
            "minimum": 0
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "day",
          "as_of",
          "views",
          "favorites",
          "orders",
          "revenue_usd",
          "source"
        ],
        "additionalProperties": false
      }
    },
    "iterations": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "hold",
        "scale",
        "iterate",
        "redefine",
        "retire"
      ]
    },
    "decision_rule": {
      "type": [
        "string",
        "null"
      ]
    },
    "decided_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "cohort_id",
    "niche",
    "launch_week",
    "listing_ids",
    "checkpoints",
    "iterations",
    "decision",
    "decision_rule",
    "decided_at"
  ],
  "additionalProperties": false
}
