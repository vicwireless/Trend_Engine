{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etsy_update_listing",
  "type": "object",
  "properties": {
    "listing_id": {
      "type": "integer"
    },
    "expect_state": {
      "enum": [
        "active"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true
    },
    "ai_assisted": {
      "type": "boolean"
    },
    "offer_type": {
      "enum": [
        "digital"
      ]
    },
    "price_usd": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "cost_snapshot": {
      "type": "string",
      "pattern": "^data/costs/.+\\.json$"
    },
    "cost_key": {
      "type": "string",
      "minLength": 1
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 70
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "name",
          "file_sha256"
        ],
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "minItems": 5,
      "maxItems": 10,
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "alt_text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 250
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "alt_text",
          "file_sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "listing_id",
    "title",
    "description",
    "tags",
    "ai_assisted",
    "price_usd",
    "cost_snapshot",
    "cost_key",
    "files",
    "images"
  ],
  "additionalProperties": false
}
