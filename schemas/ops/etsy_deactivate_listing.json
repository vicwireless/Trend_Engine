{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etsy_deactivate_listing",
  "type": "object",
  "properties": {
    "listing_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^\\$ref:ops\\[[0-9]+\\]\\.[a-z_]+$"
        }
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "listing_id",
    "reason"
  ],
  "additionalProperties": false
}
