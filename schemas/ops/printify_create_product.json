{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "printify_create_product",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 140
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 20
      },
      "maxItems": 13
    },
    "blueprint_id": {
      "type": "integer"
    },
    "print_provider_id": {
      "type": "integer"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "price_usd": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "cost_key": {
            "type": "string",
            "minLength": 1
          },
          "is_enabled": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "price_usd",
          "cost_key"
        ],
        "additionalProperties": false
      }
    },
    "print_areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "cost_snapshot": {
      "type": "string",
      "pattern": "^data/costs/.+\\.json$"
    },
    "ai_assisted": {
      "type": "boolean"
    }
  },
  "required": [
    "title",
    "description",
    "blueprint_id",
    "print_provider_id",
    "variants",
    "print_areas",
    "cost_snapshot",
    "ai_assisted"
  ],
  "additionalProperties": false
}
