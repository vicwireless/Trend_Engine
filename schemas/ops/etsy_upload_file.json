{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "etsy_upload_file",
  "type": "object",
  "properties": {
    "listing_id": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "string",
          "pattern": "^\\$ref:ops\\[[0-9]+\\]\\.[a-z_]+$"
        }
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "file_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "listing_id",
    "path",
    "file_sha256",
    "name"
  ],
  "additionalProperties": false
}
