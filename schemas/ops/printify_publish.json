{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "printify_publish",
  "type": "object",
  "properties": {
    "product_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "pattern": "^\\$ref:ops\\[[0-9]+\\]\\.[a-z_]+$"
        }
      ]
    },
    "title": {
      "type": "boolean"
    },
    "description": {
      "type": "boolean"
    },
    "images": {
      "type": "boolean"
    },
    "variants": {
      "type": "boolean"
    },
    "tags": {
      "type": "boolean"
    },
    "partner_checked": {
      "type": "boolean",
      "description": "Owner confirmed the Printify production partner is attached in Etsy (playbook \u00a76, SP-07)."
    }
  },
  "required": [
    "product_id",
    "partner_checked"
  ],
  "additionalProperties": false
}
